# Daleel local configuration. `make up` copies this to .env if it is missing.
# Every value here is a LOCAL DEV default. Never reuse these outside your machine.

# --- Postgres (owner role runs migrations; app role is subject to RLS) ---
POSTGRES_USER=daleel
POSTGRES_PASSWORD=daleel-dev-only
POSTGRES_DB=daleel
APP_DB_USER=daleel_app
APP_DB_PASSWORD=daleel-app-dev-only

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO ---
MINIO_ROOT_USER=daleel
MINIO_ROOT_PASSWORD=daleel-dev-only
S3_BUCKET=daleel

# --- Keycloak ---
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-only
# Dev-only confidential client used by `make smoke` (password grant). Not used by the SPA.
SMOKE_CLIENT_ID=daleel-smoke
SMOKE_CLIENT_SECRET=smoke-dev-only

# --- API (values below are for running the API on the host with `make dev-api`;
#     docker compose overrides the hostnames for the containerised API) ---
DATABASE_URL=postgresql+asyncpg://daleel_app:daleel-app-dev-only@localhost:5432/daleel
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://daleel:daleel-dev-only@localhost:5432/daleel
OIDC_ISSUER=http://localhost:8180/realms/daleel
OIDC_JWKS_URL=http://localhost:8180/realms/daleel/protocol/openid-connect/certs
OIDC_AUDIENCE=daleel-api
JWKS_CACHE_TTL_SECONDS=300
LOG_LEVEL=INFO

# --- Web (baked into the SPA at build time) ---
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/daleel
VITE_OIDC_CLIENT_ID=daleel-web

# --- LLM (Phase 2) ---
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
